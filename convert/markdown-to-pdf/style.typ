#let style = (
    margin: (top: 0.5in, bottom: 0.5in, left: 0.5in, right: 0.5in),
    font: ("Charter", "Libertinus Serif"),
    fontsize: 10pt,
    mathfont: ("New Computer Modern Math",),
    codefont: ("Menlo", "DejaVu Sans Mono"),
    paragraph: (justify: false, leading: 0.3em, spacing: 0.9em, linebreaks: "optimized"),
    bullet_list: (marker: [-], indent: 1.05em, body_indent: 0.3em, spacing: 0.5em),
    enum_list: (indent: 1.05em, body_indent: 0.3em, spacing: 0.5em),
    terms: (indent: 1.2em, spacing: 0.28em),
    table: (inset: (x: 4.5pt, y: 3.5pt), stroke: 0.35pt + luma(74%), fontsize: 8.8pt),
    title: (size: 15pt, subtitle_size: 12.3pt, author_size: 9.5pt, date_size: 9pt, below: 0.5em),
    heading1: (size: 14pt, weight: "bold", style: "normal", above: 1em, below: 0.48em),
    heading2: (size: 12.4pt, weight: "bold", style: "normal", above: 0.85em, below: 0.36em),
    heading3: (size: 10.8pt, weight: "semibold", style: "normal", above: 0.6em, below: 0.28em),
    heading4: (size: 10pt, weight: "regular", style: "italic", above: 0.5em, below: 0.22em),
    codeblock: (fill: luma(96%), inset: 5.5pt, radius: 1.5pt, above: 0.5em, below: 0.5em),
    footnote_size: 8.4pt,
    quote: (block: false, quotes: true),
)
